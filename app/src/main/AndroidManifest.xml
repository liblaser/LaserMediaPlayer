<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The drive is reached through the USB host API. Not required, so that
         the app installs on a device whose manifest forgets to declare it. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Android TV: no touch screen, a remote. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- The audio CD lookup: MusicBrainz, and the Cover Art Archive. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The libaacs provider, whose APK carries libaacs for libbluray - see
         NativeEnvironment.kt. Without this, it is reported missing on
         API 30+. -->
    <queries>
        <package android:name="org.libaacs.provider" />
    </queries>

    <!-- allowNativeHeapPointerTagging: off for the BD-J JVM (HotSpot 8),
         which writes native addresses into its generated code and cannot
         fit Android's tagged heap pointers (top byte set) there - "Field
         too big for insn" at start. -->
    <application
        android:name=".LaserApp"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:allowNativeHeapPointerTagging="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.LaserMediaPlayer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Plugging a drive offers to open the app, and grants the USB
                 permission when the user accepts. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- AppCompat keeps the app's language itself below Android 13. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
